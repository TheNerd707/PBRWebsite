<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us</title>
    <link rel="icon" href="/public/files/PBR_WHITE_NO_TXT.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="head">
      <div class="menuButton" onclick="change(this)">
        <div class="bar1"></div>
        <div class="bar2"></div>
        <div class="bar3"></div>
      </div>
      <div class="line"></div>
      <div class="PBRHead">PROJECT BLACK ROSE</div>
      <div class="line2"></div>
      <img src="/public/files/search.png" alt="" class="search" />
      <div class="line3"></div>
      <img src="/public/files/PBR_WHITE_NO_TXT.png" class="logo" alt="" />
    </div>
     <div class="menu">
      <div class="lineMenu"></div>
      <div class="aboutMenu textMenu">About Us</div>
      <div class="lineMenu"></div>
      <div class="applyMenu textMenu">Apply</div>
      <div class="lineMenu"></div>
      <div class="membersMenu textMenu">Members</div>
      <div class="lineMenu"></div>
      <div class="cadMenu textMenu">Our CAD</div>
      <div class="lineMenu"></div>
      <div class="galleryMenu textMenu">Gallery</div>
      <div class="lineMenu"></div>
      <div class="contactMenu textMenu">Contact Us</div>
      <div class="lineMenu"></div>
      <div class="discordMenu textMenu">Discord</div>
      <div class="lineMenu"></div>
    </div>
    <div class="about">ABOUT US</div>
    <div class="aline"></div>
    <div class="ourMotto">Our Motto</div>
    <div class="motto">"To blossom beyond pixels."</div>
    <div class="ourMission">Our Mission Statment</div>
    <div class="mission">
      “To flourish and bloom from the ashes of fallen communities. To maintain
      symbolism, respect, perseverance, and utter duty to serve our community
      with realism and authenticity to cultivate meaningful experiences beyond
      the grasp of a video game.”
    </div>
    <div class="leader">Our Leadership</div>
    <div class="container">
      <div class="img"></div>
      <div class="quote">"I haven't always been the best person"</div>
    </div>
    <div class="container">
      <div class="img2"></div>
      <div class="quote2">
        "I'm too busy coding everything to write a quote."
      </div>
    </div>
  </body>
  <style>
    html {
      margin: -7px;
      padding: none;
    }
    body {
      margin: none;
      padding: none;
      background-color: #000000;
      color: #ffffff;
      font-family: "Montserrat";
      overflow-x: hidden;
    }
    .head {
      display: flex;
      align-items: center;
      background-color: #000000;
      letter-spacing: 0.2em;
    }
    .menuButton {
      display: inline-block;
      cursor: pointer;
      margin: 0 calc(35.841 * 100vw / 1920);
      z-index: 1;
      cursor: pointer;
    }
    .bar1,
    .bar2,
    .bar3 {
      width: calc(57.628 * 100vw / 1920);
      height: calc(2.7 * 100vw / 1920) !important;
      background-color: white;
      margin: calc(12.29868 * 100vw / 1920) 0;
    }

    /* Rotate first bar */
    .change .bar1 {
      transform: translate(0, calc(14.2 * 100vw / 1920)) rotate(-45deg);
    }

    /* Fade out the second bar */
    .change .bar2 {
      opacity: 0;
    }

    /* Rotate last bar */
    .change .bar3 {
      transform: translate(0, calc(-14.2 * 100vw / 1920)) rotate(45deg);
    }
    .line {
      width: calc(2 * 100vw / 1920);
      height: calc(80 * 100vw / 1920);
      background-color: #ffffff;
      padding: none;
    }
    .PBRHead {
      position: absolute;
      font-size: calc(40 * 100vw / 1366);
      text-align: center;
      width: 100vw;
      font-family: "Montserrat";
      font-weight: 400;
      z-index: 0;
    }
    .line2 {
      position: absolute;
      width: calc(2 * 100vw / 1920);
      height: calc(80 * 100vw / 1920);
      background-color: #ffffff;
      margin-left: calc((1366 - 95) * 100vw / 1366);
    }
    .line3 {
      position: absolute;
      width: calc(2 * 100vw / 1920);
      height: calc(80 * 100vw / 1920);
      background-color: #ffffff;
      margin-left: calc((1366 - 95 - 60) * 100vw / 1366);
    }
    .logo {
      position: absolute;
      width: calc(50 * 100vw / 1366);
      height: calc(48 * 100vw / 1366);
      margin-left: calc((1366 - 16 - 50 - 10) * 100vw / 1366);
      cursor: pointer;
    }
    .search {
      position: absolute;
      width: calc(36 * 100vw / 1366);
      height: calc(36 * 100vw / 1366);
      margin-left: calc((1366 - 16 - 58 - 36 - 33) * 100vw / 1366);
    }
    .menu {
      padding-top: calc(50 * 100vw / 1366);
      position: absolute;
      display: flex;
      flex-direction: column;
      background-color: rgba(0, 0, 0, 0.5);
      width: calc(200 * 100vw / 1366);
      height: calc(378* 100vw / 1366);
      top: calc(80 * 100vw / 1920);
      left: -400px;
      transition: left 0.5s ease-in-out;
      z-index: 1000;
    }
    .lineMenu {
      width: calc(125 * 100vw / 1366);
      height: calc(3 * 100vw / 1920);
      background-color: rgba(255, 255, 255, 0.9);
      padding: none;
      margin: 0 auto;
    }
    .textMenu {
      font-size: calc(20 * 100vw / 1366);
      text-align: center;
      width: 100%;
      font-family: "Oswald";
      color: rgba(255, 255, 255, 0.9);
      font-weight: 100;
      margin-top: calc(10 * 100vw / 1366);
      margin-bottom: calc(10 * 100vw / 1366);
      cursor: pointer;
    }
    .about {
      position: absolute;
      font-size: calc(60 * 100vw / 1366);
      text-align: center;
      width: 100vw;
      font-family: "Oswald";
      font-weight: 100;
      margin-top: calc(80 * 100vw / 1366);
    }
    .aline {
      position: absolute;
      width: calc(350 * 100vw / 1366);
      height: 1px;
      background-color: #ffffff;
      left: 50%;
      transform: translateX(-50%);
      margin-top: calc(180 * 100vw / 1366);
      border-radius: 2px;
    }
    .ourMotto {
      position: absolute;
      font-size: calc(20 * 100vw / 1366);
      text-align: right;
      width: 15vw;
      font-family: "Montserrat";
      font-weight: 400;
      margin-top: calc(210 * 100vw / 1366);
    }
    .motto {
      position: absolute;
      font-size: calc(35.5 * 100vw / 1366);
      text-align: right;
      width: 30vw;
      font-family: "Oswald";
      margin-top: calc(240 * 100vw / 1366);
      font-weight: lighter;
    }
    .ourMission {
      position: absolute;
      font-size: calc(20 * 100vw / 1366);
      text-align: right;
      width: 85vw;
      font-family: "Montserrat";
      margin-top: calc(370 * 100vw / 1366);
    }
    .mission {
      position: absolute;
      font-size: calc(33.5 * 100vw / 1366);
      text-align: right;
      width: 56vw;
      font-family: "Oswald";
      margin-top: calc(400 * 100vw / 1366);
      margin-left: calc(395 * 100vw / 1366);
      font-weight: lighter;
    }
    .leader {
      position: absolute;
      font-size: calc(21.5 * 100vw / 1366);
      text-align: right;
      width: 19vw;
      font-family: "Montserrat";
      margin-top: calc(800 * 100vw / 1366);
    }
    .container {
      position: absolute;
      width: 100vw;
      margin-top: calc(850 * 100vw / 1366);
      margin-left: 8vw;
    }
    .img {
      position: absolute;
      width: calc(152 * 100vw / 1366);
      height: calc(152 * 100vw / 1366);
      background-image: url("/public//files/valiant_vii.png");
      background-size: cover;
      background-position: center;
    }
    .quote {
      position: absolute;
      font-size: calc(30 * 100vw / 1366);
      text-align: left;
      width: 60vw;
      font-family: "Montserrat";
      font-weight: 400;
      left: calc(210 * 100vw / 1366);
    }
    .img2 {
      position: absolute;
      width: calc(152 * 100vw / 1366);
      height: calc(152 * 100vw / 1366);
      background-image: url("/public//files/the_nerd1.JPG");
      background-size: cover;
      background-position: center;
      margin-top: 15vw;
      border-radius: 50%;
      overflow: hidden;
    }
    .quote2 {
      position: absolute;
      font-size: calc(30 * 100vw / 1366);
      text-align: left;
      width: 60vw;
      font-family: "Montserrat";
      font-weight: 400;
      margin-top: 15vw;
      left: calc(210 * 100vw / 1366);
    }
  </style>
  <script>
     function change(x) {
      const bar1 = document.querySelector(".bar1");
      const bar2 = document.querySelector(".bar2");
      const bar3 = document.querySelector(".bar3");

      bar1.style.transition = "0.4s"; 
      bar2.style.transition = "0.4s";
      bar3.style.transition = "0.4s";
      x.classList.toggle("change");
      const menu = document.querySelector(".menu");
      if (menu.style.left === "0px") {
        menu.style.left = "-400px";
      } else {
        menu.style.left = "0px";
      }
      setTimeout(() => {
        bar1.style.transition = "none";
        bar2.style.transition = "none";
        bar3.style.transition = "none";
      }, 400);
    }
    const textMenus = document.querySelectorAll(".textMenu");
    textMenus.forEach((textMenu) => {
      textMenu.addEventListener("click", () => {
        const menuClass = textMenu.classList[0];
        const urlMap = {
          aboutMenu: "/about",
          applyMenu: "/apply",
          membersMenu: "/members",
          cadMenu: "https://cad.simpleway.com",
          galleryMenu: "/gallery",
          contactMenu: "/contact",
          discordMenu: "/apply", // Replace with your actual Discord link
        };
        const url = urlMap[menuClass];
        
        if (url) {
          window.open(url, "_self");
        }
      });
    });
    const home = document.querySelector(".logo");
    home.addEventListener("click", () => {
      window.open("/", "_self");
    });
  </script>
</html>
