  <script>
    function change(x) {
      const bar1 = document.querySelector(".bar1");
      const bar2 = document.querySelector(".bar2");
      const bar3 = document.querySelector(".bar3");

      bar1.style.transition = "0.4s"; 
      bar2.style.transition = "0.4s";
      bar3.style.transition = "0.4s";
      x.classList.toggle("change");
      const menu = document.querySelector(".menu");
      if (menu.style.left === "0px") {
        menu.style.left = "-400px";
      } else {
        menu.style.left = "0px";
      }
      setTimeout(() => {
        bar1.style.transition = "none";
        bar2.style.transition = "none";
        bar3.style.transition = "none";
      }, 400);
    }
      function changeImg() {
        const mainImg = document.querySelector(".mainImg");
        const imgTxt = document.querySelector(".imgTxt");
        const images = [
            {
            img: "url('/public/files/mainImg1.jpg')",
            text: "REACH FOR THE SKIES"
            },
            {
            img: "url('/public/files/mainImg2.jpg')",
            text: "INTO THE UNKNOWN"
            },
            {
            img: "url('/public/files/mainImg3.jpg')",
            text: "SHOW YOUR POTENTIAL"
            },
        ];
        // Preload images
        const preloadedImages = [];
        images.forEach(imageObj => {
          const img = new Image();
          // Extract the URL from the CSS url() string
          const urlMatch = imageObj.img.match(/url\(['"]?(.*?)['"]?\)/);
          if (urlMatch && urlMatch[1]) {
            img.src = urlMatch[1];
            preloadedImages.push(img);
          }
        });
        let currentIndex = 0;
        const fadeLayer = document.createElement("div");
        fadeLayer.style.position = "absolute";
        fadeLayer.style.top = "0";
        fadeLayer.style.left = "0";
        fadeLayer.style.right = "0";
        fadeLayer.style.bottom = "0";
        fadeLayer.style.backgroundSize = "cover";
        fadeLayer.style.backgroundPosition = "center";
        fadeLayer.style.opacity = "0";
        fadeLayer.style.transition = "opacity 0.7s ease-in-out";
        fadeLayer.style.zIndex = "2";
        fadeLayer.style.pointerEvents = "none";
        mainImg.appendChild(fadeLayer);

        setInterval(() => {
          const nextIndex = (currentIndex + 1) % images.length;
          fadeLayer.style.backgroundImage = `linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0), rgba(0,0,0,0.8), rgba(0,0,0,1)), ${images[nextIndex].img}`;
          fadeLayer.style.opacity = "1";
          setTimeout(() => {
            mainImg.style.backgroundImage = fadeLayer.style.backgroundImage;
            fadeLayer.style.opacity = "0";
            currentIndex = nextIndex;
            imgTxt.textContent = images[currentIndex].text;
          }, 700);
        }, 7500);
      }
    window.onload = function () {
      const preloadImages = [
        "/public/files/mainImg1.jpg",
        "/public/files/mainImg2.jpg",
        "/public/files/mainImg3.jpg",
      ];
      preloadImages.forEach((src) => {
        const img = new Image();
        img.src = src;
      });
      changeImg();
    };

    const boxes = document.querySelectorAll(".box");
    boxes.forEach((box) => {
      box.addEventListener("mouseover", () => {
        box.style.backgroundColor = "#3e423e";
      });
      box.addEventListener("mouseout", () => {
        box.style.backgroundColor = "#252725";
        box.style.color = "#ffffff";
      });
      box.addEventListener("click", () => {
        const boxClass = box.classList[0];
        const urlMap = {
          about: "/about",
          apply: "/apply",
          members: "/members",
          cad: "https://cad.simpleway.com",
          gallery: "/gallery",
          contact: "/contact",
          discord: "/apply", // Replace with your actual Discord link
        };
        const url = urlMap[boxClass];
        
        if (url) {
          window.open(url, "_self");
        }
      });
    });
    const textMenus = document.querySelectorAll(".textMenu");
    textMenus.forEach((textMenu) => {
      textMenu.addEventListener("click", () => {
        const menuClass = textMenu.classList[0];
        const urlMap = {
          aboutMenu: "/about",
          applyMenu: "/apply",
          membersMenu: "/members",
          cadMenu: "https://cad.simpleway.com",
          galleryMenu: "/gallery",
          contactMenu: "/contact",
          discordMenu: "/apply", // Replace with your actual Discord link
        };
        const url = urlMap[menuClass];
        
        if (url) {
          window.open(url, "_self");
        }
      });
    });
  </script>
